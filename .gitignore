node_modules/
.env
# cópias do .env (têm os segredos)
.env.bak*
server/db/*.db
server/db/*.db-shm
server/db/*.db-wal

# arquivos enviados pelo pessoal (fotos, banners, ícones, anexos) — só as pastas vão pro git
public/uploads/avatars/*
public/uploads/banners/*
public/uploads/attachments/*
public/uploads/server/*
public/uploads/themes/*
public/uploads/sounds/*
!public/uploads/*/.gitkeep

# gerados ao rodar
downloads/
tunnel-url.txt
server/bots/musicBot/bin/


# testes e rascunhos locais
_teste_nvenc.h264
prompt.txt
*.orig

# servidor de mídia (LiveKit): binário baixado e chave gerada na primeira vez
server/sfu/bin/
server/sfu/data/

# arquivo temporário do FUSE quando o banco está aberto por dois processos
server/db/.fuse_hidden*

# chave PRIVADA que assina as atualizações do app novo (tauri/) — nunca vai pro git
tauri/updater-key/
*.key

# instalador do Windows esperando o `npm run release` (tauri/scripts/release.js)
tauri/release-in/

# catálogo: mídias locais imutáveis; índice e importador versionados
public/decor/media/
public/uploads/decor/*
!public/uploads/decor/.gitkeep
server/.diag-on

# provas guardadas das denúncias (anexos de mensagens denunciadas)
server/reports-evidence/
