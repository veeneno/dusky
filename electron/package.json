{
  "name": "didiscord-desktop",
  "productName": "didiscord",
  "version": "0.5.4",
  "description": "App desktop ANTIGO do dusky (Electron). name/productName/appId continuam \"didiscord\" de propósito: são a identidade da instalação (pasta, dados, desinstalador) — trocar quebraria o atualizador e a migração pro app novo (tauri/)",
  "main": "main.js",
  "author": {
    "name": "veneno",
    "email": "veneno@dusky.local"
  },
  "homepage": "https://dusky.veneno.space",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "DUSKY_DEV=1 electron .",
    "icon": "node build/make-icon.js",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build": "electron-builder --linux --win",
    "release": "electron-builder --linux --win && node scripts/publish-local.js",
    "release:linux": "electron-builder --linux && node scripts/publish-local.js"
  },
  "build": {
    "appId": "fun.sambalele.didiscord",
    "productName": "didiscord",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "deps.js",
      "screencast.js",
      "audio/**/*",
      "picker/**/*",
      "shell/**/*",
      "build/icon.png",
      "package.json",
      "updater.js",
      "presence.js"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "synopsis": "Discord privado pra você e seus amigos",
      "executableArgs": [
        "--no-sandbox"
      ],
      "extraResources": [
        {
          "from": "native/bin/dusky-screencast",
          "to": "native/dusky-screencast"
        }
      ],
      "artifactName": "dusky-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "native/bin/dusky-audiocap.exe",
          "to": "audiocap/dusky-audiocap.exe"
        },
        {
          "from": "native/bin/dusky-screencast.exe",
          "to": "native/dusky-screencast.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "dusky-setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://dusky.veneno.space/downloads/"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
