{
  "name": "didiscord-desktop",
  "productName": "didiscord",
  "version": "0.4.0",
  "description": "App desktop do didiscord (janela nativa que carrega o site hospedado)",
  "main": "main.js",
  "author": {
    "name": "veneno",
    "email": "veneno@didiscord.local"
  },
  "homepage": "https://didiscord.veneno.space",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "DIDISCORD_DEV=1 electron .",
    "icon": "node build/make-icon.js",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build": "electron-builder --linux --win"
  },
  "build": {
    "appId": "fun.sambalele.didiscord",
    "productName": "didiscord",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "deps.js",
      "screencast.js",
      "audio/**/*",
      "picker/**/*",
      "shell/**/*",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "synopsis": "Discord privado pra você e seus amigos",
      "executableArgs": [
        "--no-sandbox"
      ],
      "extraResources": [
        {
          "from": "native/bin/didiscord-screencast",
          "to": "native/didiscord-screencast"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "native/bin/didiscord-audiocap.exe",
          "to": "audiocap/didiscord-audiocap.exe"
        },
        {
          "from": "native/bin/didiscord-screencast.exe",
          "to": "native/didiscord-screencast.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
